<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SiftX\SiftX.csproj" />
  </ItemGroup>

  <!--
    Copy native sift library into runtimes/<rid>/native/ to avoid
    case-insensitive collision with the managed SiftX.dll on Windows.
  -->
  <PropertyGroup>
    <SiftXNativeDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\target\release'))</SiftXNativeDir>
    <NativeRid>$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</NativeRid>
  </PropertyGroup>

  <ItemGroup Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))">
    <None Include="$(SiftXNativeDir)\siftx.dll" CopyToOutputDirectory="PreserveNewest" Link="runtimes\$(NativeRid)\native\siftx.dll" Condition="Exists('$(SiftXNativeDir)\siftx.dll')" />
  </ItemGroup>
  <ItemGroup Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">
    <None Include="$(SiftXNativeDir)\libsiftx.so" CopyToOutputDirectory="PreserveNewest" Link="runtimes\$(NativeRid)\native\libsiftx.so" Condition="Exists('$(SiftXNativeDir)\libsiftx.so')" />
  </ItemGroup>
  <ItemGroup Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">
    <None Include="$(SiftXNativeDir)\libsiftx.dylib" CopyToOutputDirectory="PreserveNewest" Link="runtimes\$(NativeRid)\native\libsiftx.dylib" Condition="Exists('$(SiftXNativeDir)\libsiftx.dylib')" />
  </ItemGroup>

</Project>
